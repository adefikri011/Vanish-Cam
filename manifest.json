{
  "manifest_version": 3,
  "name": "Vanishing Cam",
  "version": "0.2.0",
  "description": "Vanishing Cam by @adefikri — Eksperimen efek kamuflase real-time untuk zoom berbasis computer vision.",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://meet.google.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Vanishing Cam"
  },

  "background": {
    "service_worker": "src/background.js"
  },

  "commands": {
    "toggle-vanish": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "linux": "Ctrl+Shift+Y"
      },
      "description": "Toggle Vanish / Reveal di Google Meet"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/processor/test.html",
        "src/processor/test.js",
        "src/processor/segmentation.js",
        "src/processor/meet-worker.html",
        "src/processor/meet-worker.js",
        "assets/models/*.tflite",
        "assets/vendor/mediapipe/*.mjs",
        "assets/vendor/mediapipe/wasm/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/meet-main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/meet-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}